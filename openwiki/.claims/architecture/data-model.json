  "claims": [
    {
      "id": "claim_55e9dbb8dd474e9caec441fa015fcc0e",
      "statement": "Wottle's durable game state lives in Supabase Postgres, defined through ordered SQL migrations under supabase/migrations/, where the schema evolves from a single-board MVP (boards, moves) into a two-player match model (players, matches, rounds, move_submissions).",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251105001_init.sql#L7-L119",
          "version": "repo-lines-v1:sha256:620d119cab48dd255fb2a5f58a88d69b988cd9b2b9ac32d13fab0d82a4a78057:"
        },
        {
          "resource": "repo://supabase/migrations/20251115001_playtest.sql#L5-L72",
          "version": "repo-lines-v1:sha256:bc7f5e82f14488a18a5393eb409b0fbdd48bb94caed62f03ea9756af5e614e07:"
        }
      ]
    },
    {
      "id": "claim_aed55d8cebb84862b3c56b85f2f5f358",
      "statement": "The core game entities form a matches -> rounds -> move_submissions chain anchored by players: rounds reference matches(id) via match_id, and move_submissions reference both rounds(id) via round_id and players(id) via player_id.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251115001_playtest.sql#L29-L72",
          "version": "repo-lines-v1:sha256:f691a0a4dc39aceba6ac399430f9d4cd1a40cc39442a74d3278908a58b11f98d:"
        }
      ]
    },
    {
      "id": "claim_1fb47fef32794df29ec85775394c4fd4",
      "statement": "The boards table enforces a singleton primary board: board_id defaults to 'primary-board' and the boards_singleton CHECK constraint forbids any other value, guaranteeing exactly one canonical board row.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251105001_init.sql#L8-L15",
          "version": "repo-lines-v1:sha256:bbe1c303ee80dcf8ada326c120a677528e6b3bfd87067abb2ff0d90c9848a214:"
        }
      ]
    },
    {
      "id": "claim_267b95b6fe0641aeb267f428d543921c",
      "statement": "The board grid is constrained to be square at write time: the immutable board_grid_is_square(grid jsonb) function requires a non-empty array of rows whose length equals the row count, and the boards_grid_is_square CHECK rejects any non-square grid.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251105001_init.sql#L17-L60",
          "version": "repo-lines-v1:sha256:aacb463b2a1cfdd026b22e8e0dd0f2975f2a6ed32de9fac2af803ea4e0a04188:"
        }
      ]
    },
    {
      "id": "claim_b3205661c8354d52a50e7f53c087454c",
      "statement": "Every coordinate column on the moves table is gated by the board_coordinate_in_bounds(board, coordinate) CHECK (built on board_max_index), so no persisted move can reference a cell outside the board's dimensions.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251105001_init.sql#L75-L119",
          "version": "repo-lines-v1:sha256:398ded4e70d5720310bec4708bae3ae9eba292e610bac880ac0f2864c207ea9a:"
        }
      ]
    },
    {
      "id": "claim_efcac9211e46412c99bdf18daf09b423",
      "statement": "move_submissions.status is a CHECK-constrained enum (pending, accepted, rejected_invalid, ignored_same_move, timeout) and moves.result is constrained to accepted/rejected, so only well-defined resolution states can be persisted.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251105001_init.sql#L116-L116",
          "version": "repo-lines-v1:sha256:eabe04d4b926b9f4b32da74f6e50dca74cbc71168fc3e4ada2b071af4548cbf6:"
        },
        {
          "resource": "repo://supabase/migrations/20251115001_playtest.sql#L60-L72",
          "version": "repo-lines-v1:sha256:a301a082e161cc12942fac61033be01d695c3a419233a199522f8b2e8e62604e:"
        }
      ]
    },
    {
      "id": "claim_6628153a9f9b4ddf8d65e5a0c223b7c8",
      "statement": "A round collects at most one submission per player: move_submissions has a UNIQUE (round_id, player_id) constraint, letting the round engine treat the pair as a complete, deterministically-resolvable set.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251115001_playtest.sql#L60-L72",
          "version": "repo-lines-v1:sha256:a301a082e161cc12942fac61033be01d695c3a419233a199522f8b2e8e62604e:"
        }
      ]
    },
    {
      "id": "claim_455996395154405e8850ebb029b3b28a",
      "statement": "rounds are uniquely ordered within a match via UNIQUE (match_id, round_number) and cascade-delete with their parent match (match_id references matches(id) ON DELETE CASCADE).",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251115001_playtest.sql#L48-L58",
          "version": "repo-lines-v1:sha256:6997dfe2b729a7534b72c56ed1ca7fcd2bde2bdbdf65767027c7cee00e403eb1:"
        }
      ]
    },
    {
      "id": "claim_96174f2a34b54588b4fa8d4db8485967",
      "statement": "rounds.started_at records the server timestamp when a round enters the collecting state and is set by the round engine when creating the round; it is the basis for computing per-player elapsed time for server-authoritative clock enforcement.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260225001_match_completion.sql#L1-L14",
          "version": "repo-lines-v1:sha256:fb611fdbd7555d88619cea1741bf2cb90792ce3a7bedac94c33f47aeae0ddbdb:"
        }
      ]
    },
    {
      "id": "claim_8f6aaa77981945dfa16517681d668279",
      "statement": "Each match holds per-player chess-clock budgets in matches.player_a_timer_ms and matches.player_b_timer_ms (default 300000 ms), decremented server-side, alongside current_round and a CHECK-constrained state (pending, in_progress, completed, abandoned).",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251115001_playtest.sql#L29-L43",
          "version": "repo-lines-v1:sha256:ddab5c4ee23b0eda281af266e4746181e0096e43ee8757f95bd0197f548b9a77:"
        }
      ]
    },
    {
      "id": "claim_fe413cd8eb7a4a51a2d1acf3796aabe0",
      "statement": "Frozen tiles are stored as a cumulative jsonb map in matches.frozen_tiles (keyed by 'x,y' strings with an owner value), not as a separate table; rounds.frozen_tiles_before snapshots that map as of round start so both scoring paths score against the same pre-round baseline.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260214001_frozen_tiles.sql#L4-L10",
          "version": "repo-lines-v1:sha256:976230e825aff0713012416c8b4618ed13b24586b89f14cc218e48922b37fd9b:"
        },
        {
          "resource": "repo://supabase/migrations/20260609001_rounds_frozen_tiles_before.sql#L14-L17",
          "version": "repo-lines-v1:sha256:09391df2670d0eafd2cedef149e0c0f5a192627414a4082e10245ff5bf81aa87:"
        }
      ]
    },
    {
      "id": "claim_d24646294f6844f9b237afe894552fc2",
      "statement": "The players table enforces rating and stats consistency via CHECK constraints: elo_rating >= 100, non-negative wins/losses/draws/games_played, and games_played = wins + losses + draws.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260315001_elo_rating.sql#L4-L25",
          "version": "repo-lines-v1:sha256:926147ab47a88ad340d1f471440b504f724d30d87d99545fac24e5ca88b4fae0:"
        }
      ]
    },
    {
      "id": "claim_268f706e0a8a4297bbbd006852812a1d",
      "statement": "match_ratings stores a per-match, per-player Elo snapshot (rating_before, rating_after, rating_delta, k_factor constrained to 16 or 32, match_result) unique per (match_id, player_id).",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260315001_elo_rating.sql#L28-L46",
          "version": "repo-lines-v1:sha256:da641eb759533cbf0b895c5e9bdf1db9f8463286acff05e92cb0802e9173d678:"
        }
      ]
    },
    {
      "id": "claim_364656961ed845deac0f8ef674dbb44a",
      "statement": "rematch_requests records at most one rematch per completed match (UNIQUE (match_id)), links requester and responder, and carries new_match_id once accepted; matches.rematch_of links a spawned rematch back to its source match for series-chain walking.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260316001_rematch.sql#L5-L25",
          "version": "repo-lines-v1:sha256:95b212d34008e6803837ac22c859b3f755e4d3ed4e7431933e653bf88306bd0d:"
        }
      ]
    },
    {
      "id": "claim_5b03ecf22591423eb82a8bb70e700710",
      "statement": "match_heartbeats is a per-player liveness table keyed on (match_id, player_id), upserted on every /api/match/[matchId]/state poll; loadMatchState flags a player as disconnected when last_seen_at falls behind HEARTBEAT_STALE_MS, replacing per-process in-memory state that gave false positives on Vercel's multi-instance runtime.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260423001_match_heartbeats.sql#L1-L38",
          "version": "repo-lines-v1:sha256:f54971011576200ad40e1405fbe2eca3f5d43ea6945d1adcc735efc94526aed2:"
        }
      ]
    },
    {
      "id": "claim_00525db80d884907bae7ce794cecab9f",
      "statement": "matches, rounds, move_submissions, lobby_presence, and match_invitations are added to the supabase_realtime publication with replica identity full so their state changes broadcast to subscribed clients.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251119001_enable_realtime.sql#L6-L34",
          "version": "repo-lines-v1:sha256:f54986e674014f1d09b50d48365702546cb0c0745ff9f3a1050c4e88d088ba4b:"
        }
      ]
    },
    {
      "id": "claim_25bceb8a442144aeb8212d28154fe580",
      "statement": "The nine tables created by the playtest migration originally shipped without Row-Level Security; 20260325001_rls_playtest_tables.sql closes that gap by enabling RLS and defining read/write policies for each, on the model that all writes are server-side (service_role bypasses RLS) while clients read scoped data and write only their own rows.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260325001_rls_playtest_tables.sql#L1-L177",
          "version": "repo-lines-v1:sha256:b87236a5085151536cda7c2583d7574f8ae1efc1b4796aa859b39c48d3f9244d:"
        }
      ]
    },
    {
      "id": "claim_f2ba85e36b324d32a1e28eda610c3644",
      "statement": "Match-scoped tables (rounds, move_submissions, word_score_entries, scoreboard_snapshots, match_logs, match_heartbeats) gate SELECT via an EXISTS check that the caller (auth.uid()) is player_a_id or player_b_id of the parent match; matches itself is directly participant-scoped.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260325001_rls_playtest_tables.sql#L52-L177",
          "version": "repo-lines-v1:sha256:e38503a83ae84ed56ee2428aececa9be8b2ed8e71ddd8020a3eef9cfe4380f4e:"
