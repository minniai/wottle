    {
      "id": "claim_b55161dccee14af3a94f5bac01c6821b",
      "statement": "Wottle is server-authoritative: the browser is view-only and all game state mutations run server-side, enforced by entrypoints reading the session and authorizing the caller before writing (e.g. submitMove verifies the caller is one of the match's two players).",
      "evidence": [
        {
          "resource": "repo://app/actions/match/submitMove.ts#L24-L57",
          "version": "repo-lines-v1:sha256:757379f23be265dda77851b3c62f7d253b84c7fc3c2d2059bc8d7c700971eaa7:"
        }
      ]
    },
