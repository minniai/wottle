    {
      "id": "claim_b91fb5f9ecea4301827057fc316fda7c",
      "statement": "Wottle is organized in three layers: app/ route segments plus server entrypoints on top (Server Actions under app/actions/* and API Route Handlers under app/api/*), framework-agnostic domain modules in lib/ in the middle, and Supabase (Postgres, Realtime, Auth) as the backing service.",
      "evidence": [
        {
          "resource": "repo://app/actions/README.md#L1-L9",
          "version": "repo-lines-v1:sha256:4e452bc7ad8ec3e8028d7fbdfe67be646739ef18253045201d2b775e23c80549:"
