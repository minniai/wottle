          "version": "repo-lines-v1:sha256:88f21b0d21b24625fe10425da61d4762a9a7461e9692fa663d22bbb0428e4826:"
        }
      ]
    },
    {
      "id": "claim_861185a12f0b4c3da67e8a7a03e2a600",
      "statement": "MatchClient runs three overlapping transports: a primary Supabase Realtime subscription to match:${matchId}, a REST polling fallback of /api/match/{matchId}/state used only when Realtime is confirmed down, and an always-on slow safety-net poller that applies a snapshot only when shouldApplySafetySnapshot detects the client is behind.",
      "evidence": [
        {
          "resource": "repo://components/match/MatchClient.tsx#L433-L491",
