    {
      "id": "claim_7823b5129a504049927429a5b01eab77",
      "statement": "The Next.js client renders server-authoritative match state and never computes game outcomes (scores, round summaries, completion) itself; MatchClient is seeded with an initialState MatchState and replaces its matchState only from server snapshots delivered via Realtime or the REST poller.",
      "evidence": [
        {
          "resource": "repo://components/match/MatchClient.tsx#L213-L230",
          "version": "repo-lines-v1:sha256:dc2d1e898e30a2234adf2f26c71beda69a8a1c88f2a99d0eca1108431433a7b2:"
        },
        {
