    {
      "id": "claim_485ef34ca8734a2bb4244fa0791f9766",
      "statement": "State and round-summary broadcasts are best-effort: they cap the wait for SUBSCRIBED at a 2s timeout (BROADCAST_SUBSCRIBE_TIMEOUT_MS), and on timeout they log, remove the channel, and resolve rather than blocking the mutation, because Supabase's ~10s default would stall the round-advancement pipeline.",
      "evidence": [
        {
          "resource": "repo://app/actions/match/publishRoundSummary.ts#L133-L173",
          "version": "repo-lines-v1:sha256:8b2749797183223a413bf0608f8734fa45c729645b8f0e92f8d93991aa8074ec:"
