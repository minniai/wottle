    {
      "id": "claim_9d0bdb651d804ef48363508dbc2c9290",
      "statement": "All match-scoped realtime traffic is multiplexed over a single Supabase channel topic `match:${matchId}`, carrying three distinct broadcast events: `state` (MatchState snapshot), `round-summary` (RoundSummary), and `rematch` (RematchEvent).",
