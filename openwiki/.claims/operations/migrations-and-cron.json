    {
      "id": "claim_6fc5282b8eee459ba38dc4fa75b77187",
      "statement": "The sweep migration 20260424001_sweep_stale_matches.sql defines the SQL function public.find_orphaned_matches(), which returns ids of matches in state 'in_progress' for which neither participant (player_a_id or player_b_id) has a lobby_presence row with expires_at greater than now(); a match is thus considered orphaned only when both players' presence has expired.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260424001_sweep_stale_matches.sql#L26-L45",
          "version": "repo-lines-v1:sha256:0dc99fd969a07d7e99c3cda368dead509dd3cad14c2fa5174c56e04a077388f2:"
        }
      ]
    },
    {
      "id": "claim_e0f05aef0ae745359c3b24c89f14e78b",
      "statement": "The same sweep migration extends the matches_ended_reason_check CHECK constraint to allow the value 'abandoned', which is the ended_reason recorded for sweep-finalized matches.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260424001_sweep_stale_matches.sql#L8-L24",
          "version": "repo-lines-v1:sha256:f0d89603a4e83e9f5defe9757d8fa75d4676346b0c43a07d007729e4e8c94fc0:"
        }
