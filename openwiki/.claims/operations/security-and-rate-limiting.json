        }
      ]
    },
    {
      "id": "claim_6c97b97b36934c9a8047e8d60951cba4",
      "statement": "Rate-limit counters live in a single Map stored on globalThis under __wottleRateLimitStore__, making the limiter per-process and not distributed across instances, so the effective ceiling scales with instance count rather than enforcing a strict global cap.",
      "evidence": [
