    {
      "id": "claim_c3dc844eca9d49bbad65a95248c02f90",
      "statement": "assertWithinRateLimit is a synchronous fixed-window counter keyed by `${scope}:${identifier}` (identifier trimmed/lowercased, blank collapsing to 'anonymous') that starts a fresh window when none exists or it has elapsed, increments otherwise, returns a {remaining, resetAt} snapshot, and rejects non-positive limit or windowMs as an invalid configuration.",
      "evidence": [
        {
          "resource": "repo://lib/rate-limiting/middleware.ts#L69-L120",
          "version": "repo-lines-v1:sha256:8d34527aaa89b0b9b993184dbc191732f32bddcfc89479131d6dc44f1cd8a5db:"
        }
      ]
    },
    {
      "id": "claim_aea9a42027044a83afe2ee81034bd4d7",
      "statement": "When the limit is exceeded assertWithinRateLimit throws RateLimitExceededError carrying scope, retryAfterSeconds (ceil((resetAt-now)/1000), min 1), and statusCode 429; isRateLimitError is the type guard callers use to detect it and surface a retry hint.",
      "evidence": [
        {
          "resource": "repo://app/actions/match/claimWin.ts#L38-L51",
          "version": "repo-lines-v1:sha256:00818ac60119e6e3b6b36d0dee379ca9da3d965375079ea9bbfe39cb80318408:"
