    },
    {
      "id": "claim_cb6ec5f4c87641c4b8b6ce271369d525",
      "statement": "The guard:no-service-role static check recursively scans the app and components directories and fails the process (exit code 1) if any source file contains SUPABASE_SERVICE_ROLE_KEY or the literal 'service_role', acting as a CI-level defense against leaking the service role into client code.",
      "evidence": [
        {
          "resource": "repo://package.json#L19-L19",
          "version": "repo-lines-v1:sha256:a1a3fc4425cf04193bef8a85a053221f0d6accf6f80a1e081db2d2fdfd894e46:"
