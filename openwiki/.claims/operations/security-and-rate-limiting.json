    },
    {
      "id": "claim_6086356bf01c4d72bddaa73b05747aa1",
      "statement": "The playtest RLS migration enables Row Level Security on nine tables (players, lobby_presence, matches, rounds, move_submissions, match_invitations, word_score_entries, scoreboard_snapshots, match_logs) and scopes reads to match participants via player_a_id = auth.uid() OR player_b_id = auth.uid(), while leaving most writes to the service role which bypasses RLS.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260325001_rls_playtest_tables.sql#L1-L177",
          "version": "repo-lines-v1:sha256:b87236a5085151536cda7c2583d7574f8ae1efc1b4796aa859b39c48d3f9244d:"
        }
      ]
    },
    {
      "id": "claim_1c60d0cbad954b70a68f20d2202544f7",
      "statement": "The RLS design permits a limited set of ownership-checked client writes: players may update their own profile (id = auth.uid()), upsert/delete their own lobby_presence row, insert their own move_submissions, send invitations as sender_id = auth.uid(), and update invitations they received as recipient_id = auth.uid().",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20260325001_rls_playtest_tables.sql#L20-L124",
          "version": "repo-lines-v1:sha256:6da0de44b4bd3038f7dd28a2cca3339dab39fdb948cacbf794bffeb0918242a3:"
        }
      ]
