    {
      "id": "claim_1f7db9e564424497a0dc31a19a1a18aa",
      "statement": "`pnpm quickstart` (scripts/supabase/quickstart.sh) is the supported one-command local setup: it runs a Supabase/Docker preflight, starts the Docker stack, reads credentials from `supabase status`, writes/updates `.env.local`, then applies migrations and seeds/verifies data.",
      "evidence": [
        {
          "resource": "repo://README.md#L88-L92",
          "version": "repo-lines-v1:sha256:1de2dd8415c12cb424c58697091d26b5972f595c48cd38d9a01de873ee4d4891:"
        },
        {
          "resource": "repo://scripts/supabase/quickstart.sh#L113-L233",
          "version": "repo-lines-v1:sha256:74edfface4c247d75d7d356cb3473f25cff7925ac5f8b05797155e721b77fb0e:"
        }
      ]
    },
    {
      "id": "claim_9f73480ac8a74b64a020feee31cac505",
      "statement": "There is no committed `.env.example`; quickstart itself materializes local configuration by writing `NEXT_PUBLIC_SUPABASE_URL`, `SUPABASE_SERVICE_ROLE_KEY`, `NEXT_PUBLIC_SUPABASE_ANON_KEY`, and `SUPABASE_ANON_KEY` into `.env.local` (and `.env.production.local` when present) via sync_env_values.",
      "evidence": [
        {
          "resource": "repo://README.md#L90-L92",
          "version": "repo-lines-v1:sha256:416541288d72922d9d2e5825488bb1b3f99034bf880159aed7dd34992599be20:"
        },
        {
          "resource": "repo://scripts/supabase/quickstart.sh#L199-L207",
