          "version": "repo-lines-v1:sha256:be71eafe9ccd3b018e7fefacc7970ae990a83c4ff41977ff8fb971c77dce0aca:"
        }
      ]
    },
    {
      "id": "claim_ca5bb635bfcc478a9f9100fdb48358bc",
      "statement": "The service-role key is server-only: lib/supabase/server.ts imports `server-only`, throws if constructed with a defined `window` (browser), and is the single constructor of the service-role Supabase client used by Server Actions and scripts.",
      "evidence": [
        {
          "resource": "repo://lib/supabase/server.ts#L1-L40",
          "version": "repo-lines-v1:sha256:3d5a27b15f8783e34adb1b7e2bb89212a1bb03ab08ee1663a7fc6945f0e9117a:"
        }
      ]
    },
    {
      "id": "claim_ea2bc1aea07740f89def8fa66f72b305",
      "statement": "A CI guard (scripts/guards/no-service-role-in-client.ts, `pnpm guard:no-service-role`) enforces the server-only invariant by scanning `app/` and `components/` for `SUPABASE_SERVICE_ROLE_KEY` or `service_role` and failing when either appears in client-reachable code.",
      "evidence": [
        {
          "resource": "repo://package.json#L19-L19",
