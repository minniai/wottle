    {
      "id": "claim_5cfa1b4bc20c4b23899511ceb9e6a9dc",
      "statement": "Playtest UI is gated by two build-time feature flags in lib/constants/featureFlags.ts: `NEXT_PUBLIC_ENABLE_PLAYTEST_LOBBY` (playtestLobby) and `NEXT_PUBLIC_ENABLE_PLAYTEST_MATCH` (playtestMatchView), each parsed by readFlag which treats 1/true/on/yes/enabled as true and defaults to false.",
      "evidence": [
        {
          "resource": "repo://lib/constants/featureFlags.ts#L1-L15",
