        }
      ]
    },
    {
      "id": "claim_7d96bc86c9ba47c695d7399040f89813",
      "statement": "DEFAULT_GAME_CONFIG (lib/constants/game-config.ts) defines the default match rules: 10x10 board, timePerRoundMs 60000 (60s), minimumWordLength 3, horizontal/vertical directions, and Icelandic ('is'); minimumWordLength is read across the whole scoring pipeline so changing it alters scoring end to end.",
      "evidence": [
        {
          "resource": "repo://lib/constants/game-config.ts#L3-L13",
          "version": "repo-lines-v1:sha256:14100124c129ae57d48cb3df13b6541143e73cd951e9ae7d079e231621604320:"
        }
      ]
    },
    {
      "id": "claim_886abf9399a1420fa7339547638264b2",
      "statement": "The default rounds-per-match is `maxRounds: 10` in DEFAULT_GAME_CONFIG, which contradicts the README's default-configuration table that lists 5 rounds; the code constant is authoritative.",
