        }
      ]
    },
    {
      "id": "claim_8167f6f242554662b40f3dbb10e4e761",
      "statement": "quickstart's preflight (scripts/supabase/preflight.ts) hard-requires prerequisites before starting: it verifies the Docker daemon via `docker info`, the Supabase CLI via `supabase --version`, and a non-empty `SUPABASE_ACCESS_TOKEN`, throwing (aborting the run) when any check fails.",
      "evidence": [
        {
          "resource": "repo://scripts/supabase/preflight.ts#L39-L84",
          "version": "repo-lines-v1:sha256:2945f15ea5c866d617af82bd03dff9d59a12eb5a8179685d67136158d9d9fce5:"
