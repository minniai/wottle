  "claims": [
    {
      "id": "claim_c6abd9a1a0e3461f8be3f8e528216929",
      "statement": "Login has two behaviorally equivalent entrypoints — the loginAction Server Action and the POST /api/auth/login route — that both delegate to performUsernameLogin and persistLobbySession from lib/matchmaking/profile.ts.",
      "evidence": [
        {
          "resource": "repo://app/actions/auth/login.ts#L28-L56",
          "version": "repo-lines-v1:sha256:4de5e42c0bc942408e9c3651519e2422cfb7772ad6d012b9c20b0898cf99e31b:"
