    {
      "id": "claim_a0a065bb64004f6db4e439abd90b1b5f",
      "statement": "Login upserts the player identity into the players table with onConflict 'username' (storing a lowercased username), so logging in with an existing username returns the same player rather than creating a duplicate.",
      "evidence": [
        {
          "resource": "repo://lib/matchmaking/profile.ts#L80-L89",
          "version": "repo-lines-v1:sha256:37c592e9ffaae753934899f70ce824f04a7859166b544763f14feed907d1351c:"
