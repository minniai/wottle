        }
      ]
    },
    {
      "id": "claim_b1a889f367cc473eb8271009bf9100e0",
      "statement": "performUsernameLogin validates the username with a Zod schema (3-24 chars from letters including Icelandic glyphs, digits, underscore, hyphen) and throws LoginValidationError on failure, which the API route maps to HTTP 400.",
      "evidence": [
        {
          "resource": "repo://app/api/auth/login/route.ts#L72-L77",
          "version": "repo-lines-v1:sha256:d54bf0503c4e42f518169449df74089b1e5fae57dc7e4f43f8b21ca5346eb369:"
