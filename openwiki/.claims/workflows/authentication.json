    },
    {
      "id": "claim_0d1d659085644aaba1487c68516b3292",
      "statement": "Identity and presence writes during login use the Supabase service-role client (getServiceRoleClient), which bypasses row-level security; there is no per-user JWT and authorization is enforced in application code rather than by the database.",
      "evidence": [
        {
          "resource": "repo://lib/matchmaking/profile.ts#L150-L165",
          "version": "repo-lines-v1:sha256:df1f5b8f70d586b506da0485a7953806e1b8b4855144a562827cd36230737374:"
