    {
      "id": "claim_a91eab9582ad42739f30abfcce774d50",
      "statement": "persistLobbySession writes the cookie named wottle-playtest-session with httpOnly true, sameSite lax, path '/', maxAge of SESSION_TTL_SECONDS (4 hours), and a secure flag decided by shouldUseSecureCookies().",
      "evidence": [
        {
          "resource": "repo://lib/matchmaking/profile.ts#L127-L148",
          "version": "repo-lines-v1:sha256:89f6ac1133240af085d4afaf0cf16cf7946845feb06cab463e433b7ad68a358a:"
        },
        {
