        }
      ]
    },
    {
      "id": "claim_3d799dd5192744e3893bd33e7a4a5e06",
      "statement": "Login upserts a lobby_presence row (onConflict player_id, mode 'auto', TTL from PLAYTEST_PRESENCE_TTL_SECONDS defaulting to 300s) and then reads it back from the database, throwing if the presence record cannot be verified.",
      "evidence": [
        {
          "resource": "repo://lib/matchmaking/profile.ts#L303-L314",
          "version": "repo-lines-v1:sha256:115354b077f40bc8409b6dabf9dcad5f96ba8a23d46ea446af6220369c82198e:"
