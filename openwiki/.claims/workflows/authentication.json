        }
      ]
    },
    {
      "id": "claim_ddfb797a9e874af08855f6d563f98c8d",
      "statement": "Gameplay Server Actions authorize callers via readLobbySession, treating a null result as unauthorized and using session.player.id both as the rate-limit identifier and to verify match participation, as in submitMove which returns { error: 'Unauthorized' } without a session.",
      "evidence": [
        {
          "resource": "repo://app/actions/match/submitMove.ts#L24-L57",
          "version": "repo-lines-v1:sha256:757379f23be265dda77851b3c62f7d253b84c7fc3c2d2059bc8d7c700971eaa7:"
        }
