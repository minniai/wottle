    {
      "id": "claim_ccb8aa3cb29841f5aa95e769daf3b6c0",
      "statement": "readLobbySession is the shared authorization primitive: it decodes and Zod-validates the session cookie and returns null (fail-closed) on any missing, malformed, or schema-invalid cookie rather than throwing.",
      "evidence": [
        {
          "resource": "repo://lib/matchmaking/profile.ts#L150-L165",
          "version": "repo-lines-v1:sha256:df1f5b8f70d586b506da0485a7953806e1b8b4855144a562827cd36230737374:"
