        }
      ]
    },
    {
      "id": "claim_80ae0e62e1b5456c833f5b7b4f146e3d",
      "statement": "The session token is a random UUID (crypto.randomUUID) and the session cookie is a base64url-encoded JSON LobbySession that embeds the full player identity (id, username, displayName, avatar, status, lastSeenAt, elo), so session reads never re-query the database for identity.",
      "evidence": [
        {
          "resource": "repo://lib/matchmaking/profile.ts#L121-L148",
          "version": "repo-lines-v1:sha256:6908ee5109c38389d5f19a2d68509dc4aab68936c1d613131f9eb1feaf4f0779:"
