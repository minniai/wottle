        }
      ]
    },
    {
      "id": "claim_1e45df14f1e64563af09e7ed783c04df",
      "statement": "shouldUseSecureCookies() sets the session cookie secure flag by first honoring PLAYTEST_SESSION_SECURE truthy/falsy tokens, then disabling secure when CI is true/1, and otherwise falling back to NODE_ENV === 'production'.",
      "evidence": [
        {
          "resource": "repo://lib/matchmaking/profile.ts#L328-L357",
          "version": "repo-lines-v1:sha256:03805afc3b3b0ce7355ec9c88859b15dad94b79aa694781015cffd2c84dee12c:"
        }
