        }
      ]
    },
    {
      "id": "claim_a3274110c2704a8e8ff52623d1ff1e49",
      "statement": "Because identity is cached in the cookie, the cookie-tracked player status can drift from the players table; healStuckInMatchStatus reconciles this by resetting a players row stuck at 'in_match' to 'available' when no active match exists, and never throws so lobby page loads are not broken.",
      "evidence": [
        {
          "resource": "repo://lib/matchmaking/profile.ts#L227-L285",
          "version": "repo-lines-v1:sha256:e5d21657121c6a8b1782b87f11e19e1550b62db66d5e820231d91700ba29bbe1:"
        }
