    },
    {
      "id": "claim_8ad12a7fd84b4d20a5a9d107bd46658b",
      "statement": "Both login entrypoints enforce a rate limit of 5 attempts per 60s under scope auth:login keyed by the resolved client IP before doing any login work; the API route returns HTTP 429 with a retry-after header on exceed.",
      "evidence": [
        {
          "resource": "repo://app/actions/auth/login.ts#L33-L44",
          "version": "repo-lines-v1:sha256:00cbe0144a2666601338422afe13068829fc7fe76143b3bec6ee89b12567e6be:"
