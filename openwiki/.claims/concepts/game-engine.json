    },
    {
      "id": "claim_83a62ef1f53143f4b65bfca907a9cecc",
      "statement": "Dictionary loading is defensive: an empty file, a missing file (ENOENT), or a file with fewer than the language's configured minEntries all raise a DictionaryLoadError instead of running on a corrupt dictionary.",
      "evidence": [
        {
          "resource": "repo://lib/game-engine/dictionary.ts#L102-L160",
