    {
      "id": "claim_26a56e518ee54707b083efb21f50868c",
      "statement": "Icelandic (is) is the default dictionary, sourced from data/wordlists/word_list_is.txt with a minEntries floor of 2,000,000, and refined by a removal-only curated overlay data/wordlists/word_list_is_exclusions.txt applied via applyExclusions; missing real words are treated as upstream extraction bugs rather than in-repo additions.",
