  "claims": [
    {
      "id": "claim_3649ebc5e6c4473da2f28062999725a0",
      "statement": "The game engine under lib/game-engine/ is a pure, persistence-free core: given a pre-round board and accepted swaps it computes, validates, and scores words, with no knowledge of HTTP, persistence, or match orchestration.",
      "evidence": [
        {
          "resource": "repo://docs/prd_and_requirements/wottle_game_rules.md#L200-L217",
          "version": "repo-lines-v1:sha256:7c04f927bf383a5c53c501569a9f8d794470475a53acd9289be1a45f1d0b11df:"
        },
        {
          "resource": "repo://lib/game-engine/wordEngine.ts#L234-L337",
          "version": "repo-lines-v1:sha256:ce62df9b477259b00a08adae8a1ef238eb3ead2004aebcd9594512802226ed98:"
        }
      ]
    },
    {
      "id": "claim_7d97057ff22f40a389ebd7ea272df5e5",
      "statement": "The board is represented as a BoardGrid (string[][]) with {x,y} coordinates indexed grid[y][x], validated by a Zod schema to be boardSize×boardSize (default 10) with single-letter or space cells and in-range coordinates.",
      "evidence": [
        {
          "resource": "repo://lib/types/board.ts#L5-L37",
          "version": "repo-lines-v1:sha256:50d8c7d141479ad846be86d8241357de4ef21fb24ecd07d064b03f571ed968ba:"
        }
      ]
    },
    {
      "id": "claim_627d19ffad1e407394d0f6c41d8d3a8e",
      "statement": "applySwap is immutable: it clones the grid, validates both endpoints, rejects swapping a tile with itself, exchanges the two cells on the clone, and returns the new grid without mutating the input.",
      "evidence": [
        {
          "resource": "repo://lib/game-engine/board.ts#L8-L33",
          "version": "repo-lines-v1:sha256:d9fdca355739b7669f73c2423dee5b14cbc45b41ed9566063e27370ac4c5d863:"
        }
      ]
    },
    {
      "id": "claim_73b81cd705da4f3a9868e5e1dc70c151",
      "statement": "processRoundScoring orchestrates a round by loading the dictionary, sorting moves with sortByPrecedence (ascending submittedAt, player_a wins ties), and processing each move sequentially so later moves see the mutated board and updated frozen-tile map.",
      "evidence": [
        {
          "resource": "repo://lib/game-engine/wordEngine.ts#L128-L143",
          "version": "repo-lines-v1:sha256:dd1eba460b1c4df96e6f54b1a75a2e8b91c3bc33e29498affb3a0d8b78eb9c07:"
        },
        {
          "resource": "repo://lib/game-engine/wordEngine.ts#L268-L300",
          "version": "repo-lines-v1:sha256:b3fbe63b3c95ed31b17eea6551257d62e0a9521634be7d5cd1c46dcdae9664b1:"
        }
      ]
    },
    {
      "id": "claim_3e5f7460ea01441c9ecd8262dd27bfc6",
      "statement": "processPlayerMove rejects a swap outright if either endpoint is already frozen (including tiles frozen earlier in the same round); otherwise it runs applySwap, scanFromSwapCoordinates, selectOptimalCombination, scoreBoardWords, and freezeTiles in that order.",
      "evidence": [
        {
          "resource": "repo://lib/game-engine/wordEngine.ts#L148-L221",
          "version": "repo-lines-v1:sha256:68d210196537a8002d13f2a710380294362f08dfa5d2b991637184b3f3906389:"
        }
      ]
    },
    {
      "id": "claim_0d160427506d484c805c77cf0e976cd1",
      "statement": "scanFromSwapCoordinates generates candidates by tracing only the two orthogonal axes through each swap coordinate, enumerating every subsequence that includes the swap index and meets minimumWordLength, checking both forward and reverse readings against the dictionary, and deduplicating by a text:direction:startX,startY key.",
      "evidence": [
        {
          "resource": "repo://lib/game-engine/boardScanner.ts#L171-L238",
          "version": "repo-lines-v1:sha256:a142079d6b25f121adf18c2b77765897eecdbc230355db17220a3a4bcef892eb:"
        }
      ]
    },
    {
      "id": "claim_300af55465294022b8246e1767c45915",
      "statement": "scanBoard is a separate whole-board scanner over four canonical direction vectors (with reverse readings, covering all eight directions including diagonals) that returns a ScanResult with timing; it is used by deltaDetector rather than the swap pipeline.",
      "evidence": [
        {
          "resource": "repo://lib/game-engine/boardScanner.ts#L254-L310",
          "version": "repo-lines-v1:sha256:ff28e86caf3a19d23787419dc6ff77bbc802bb0dd6a79a3c8074960b9d88daac:"
        },
        {
          "resource": "repo://lib/game-engine/deltaDetector.ts#L415-L431",
          "version": "repo-lines-v1:sha256:f62d3e86c28bcc9ee8e7167423e0c8e04633db54f4447e663a58dc4cf83930c6:"
        }
      ]
    },
    {
      "id": "claim_a9650694b2ab4956a53f631d1feacca1",
      "statement": "selectOptimalCombination enumerates every non-empty subset of candidate words, prunes same-axis conflicts, validates each survivor, and returns the maximum-scoring valid subset, deliberately deferring all cross-validation to the subset stage with no per-candidate pre-filter.",
      "evidence": [
        {
          "resource": "repo://docs/prd_and_requirements/wottle_game_rules.md#L219-L228",
          "version": "repo-lines-v1:sha256:ba8bad998784e9e3de77340871de1394a8a5aba83cad59855ec659fdf1d68bb0:"
        },
        {
          "resource": "repo://lib/game-engine/crossValidator.ts#L221-L274",
          "version": "repo-lines-v1:sha256:eca91dcc7359efa787e115ebd9765cc606f7cedfc09da3c43117155be11e5fc8:"
        }
      ]
    },
    {
      "id": "claim_e0b214bd82c347f3b909ab82a1a1c73f",
      "statement": "deltaDetector.detectNewWords attributes new words per player via a three-scan diff (baseline, after Player A swaps, final board), then filters to orthogonal directions, suppresses sub-words and invalid suffix/prefix overlaps, and rejects cross-word and inline-extension violations.",
      "evidence": [
        {
          "resource": "repo://lib/game-engine/deltaDetector.ts#L386-L528",
          "version": "repo-lines-v1:sha256:a27de38619a20c784dd43e17783c2b85c5c96f99f11e014dbca5ce85baceb24b:"
        }
      ]
    },
    {
      "id": "claim_a5c59d5a104e4aa789fad63846bf738f",
      "statement": "loadDictionary reads a language wordlist synchronously into an in-memory Set for O(1) lookups, relies on the wordlist being pre-NFC-normalized and pre-lowercased, and caches the result per language in a module-level map cleared by resetDictionaryCache.",
      "evidence": [
        {
          "resource": "repo://lib/game-engine/dictionary.ts#L183-L189",
          "version": "repo-lines-v1:sha256:85f16604ac5bd64ce6b37163b905e32b8782c4ea7dcffff5d5aaec7e76202c4c:"
